{
  "name": "domfabrik-front",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "github",
    "url": "https://github.com/domfabrik/vendure-nextjs-storefront"
  },
  "scripts": {
    "dev": "next dev --turbo -p 3001",
    "format": "biome check --write",
    "lint": "biome check && tsc --noEmit",
    "lint:fsd": "steiger ./src",
    "test": "node --experimental-strip-types scripts/metrika-config-test.mjs && node --experimental-strip-types scripts/indexation-policy-test.mjs && node scripts/api-routing-contract-test.mjs && node scripts/biome-isolation-test.mjs && node scripts/ci-seo-contract-test.mjs",
    "test:api-routing": "node scripts/api-routing-contract-test.mjs",
    "test:ci-seo": "node scripts/ci-seo-contract-test.mjs",
    "test:indexation": "node --experimental-strip-types scripts/indexation-policy-test.mjs",
    "test:isolation": "node scripts/biome-isolation-test.mjs",
    "test:seo": "node scripts/seo-http-test.mjs",
    "test:metrika": "node --experimental-strip-types scripts/metrika-config-test.mjs",
    "prebuild": "yarn lint && yarn lint:fsd",
    "build": "yarn prebuild && next build",
    "postbuild": "node scripts/strip-standalone-env.mjs",
    "start": "next start -p 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hookform/resolvers": "5.4.0",
    "@mui/icons-material": "9.3.1",
    "@mui/lab": "9.0.0-beta.8",
    "@mui/material": "9.3.1",
    "@mui/material-nextjs": "9.3.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "geist": "1.7.2",
    "graphql": "16.14.0",
    "graphql-request": "7.4.0",
    "next": "16.2.6",
    "nuqs": "2.8.9",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hook-form": "7.74.0",
    "server-only": "0.0.1",
    "zod": "4.3.6",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@feature-sliced/steiger-plugin": "0.5.8",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "husky": "9.1.7",
    "steiger": "0.5.12",
    "typescript": "6.0.3"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ]
}
